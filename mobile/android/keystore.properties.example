# Copy to keystore.properties (gitignored) and fill in. Never commit the real
# file or the keystore itself. Back both up somewhere safe outside the repo:
# if the key is lost, installed copies of the app can never be updated.
#
# storeFile is relative to mobile/android/, or an absolute path.
storeFile=../../../geoclick-release.jks
storePassword=
keyAlias=geoclick
keyPassword=
