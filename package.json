{
	"name": "geoclick",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": ["app", "packages/*"],
	"scripts": {
		"dev": "npm run dev --workspace=app",
		"build": "npm run build --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"check": "npm run check --workspaces --if-present",
		"lint": "npm run lint --workspace=app",
		"format": "npm run format --workspace=app",
		"build-map": "tsx data/scripts/build-map.ts",
		"deploy": "npm run build --workspace=app && wrangler pages deploy app/build --project-name=geoclick2027"
	},
	"devDependencies": {
		"mapshaper": "^0.6.115",
		"tsx": "^4.20.6",
		"wrangler": "^4.130.0"
	}
}
