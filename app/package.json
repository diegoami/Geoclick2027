{
	"name": "app",
	"private": true,
	"version": "0.12.0-beta.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"predev": "node scripts/prepare-assets.mjs",
		"build": "vite build",
		"prebuild": "node scripts/prepare-assets.mjs",
		"postbuild": "node scripts/check-build-assets.mjs && node scripts/copy-maplibre-worker.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run --reporter=verbose"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "~4.1.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@capacitor-community/sqlite": "^8.1.1",
		"@capacitor/app": "^8.1.1",
		"@capacitor/core": "^8.5.2",
		"@geoclick/quiz-engine": "*",
		"@geoclick/srs": "*",
		"@sveltejs/adapter-static": "^3.0.10",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-sql": "^2.4.1",
		"maplibre-gl": "^6.9.0",
		"pmtiles": "^4.5.0"
	}
}
