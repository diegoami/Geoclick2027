.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Packaged release installers (scripts/package-release.mjs) - published, never committed
/dist-release

# Claude Code: the review-handoff skill in .claude/skills/ is tracked;
# machine-local settings and agent worktrees are not.
.claude/settings.local.json
.claude/worktrees/

# external reviewer scratch
rendered/
