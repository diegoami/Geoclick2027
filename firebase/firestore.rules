rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function text(v, max) { return v is string && v.size() <= max && v.matches('[^\\x00-\\x1f\\x7f]+'); }
  function token(v) { return v is string && v.matches('[A-Za-z0-9_-]{1,128}'); }
  function integer(v, min, max) { return v is int && v >= min && v <= max; }
  function number(v, min, max) { return v is number && v >= min && v <= max; }
  function day(v) { return v is string && v.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'); }
  function summary(v) {
   return v is map && v.keys().hasAll(['total','perfect','totalErrors','completedAt'])
    && v.keys().hasOnly(['total','perfect','totalErrors','completedAt'])
    && integer(v.total, 0, 10000) && integer(v.perfect, 0, v.total)
    && integer(v.totalErrors, 0, 1000000)
    && v.completedAt is string && v.completedAt.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z');
  }
  function state(v) {
   return v is map && v.keys().hasAll(['easeFactor','interval','repetitions','cleanStreak','dueDate','lastReviewedAt'])
    && v.keys().hasOnly(['easeFactor','interval','repetitions','cleanStreak','dueDate','lastReviewedAt'])
    && number(v.easeFactor, 1.3, 2.5) && integer(v.interval, 0, 365)
    && integer(v.repetitions, 0, 1000000) && integer(v.cleanStreak, 0, 3)
    && day(v.dueDate) && day(v.lastReviewedAt);
  }
  function records(v) {
   return v is map && v.keys().hasOnly(['bestTimeMs','slipped','confusions'])
    && (!('bestTimeMs' in v) || number(v.bestTimeMs, 0.001, 1000000000000))
    && (!('slipped' in v) || integer(v.slipped, 0, 10000))
    // Entire bounded encoding is checked in one expression (20 nested map checks exceed the rules budget).
    && (!('confusions' in v) || (v.confusions is string && v.confusions.size() <= 10439
     && v.confusions.matches('([^\\x00-\\x1f\\x7f]{1,256}\\t[^\\x00-\\x1f\\x7f]{1,256}\\t([1-9][0-9]{0,5}|1000000)(\\n[^\\x00-\\x1f\\x7f]{1,256}\\t[^\\x00-\\x1f\\x7f]{1,256}\\t([1-9][0-9]{0,5}|1000000)){0,19})?')));
  }
  function operation(v) {
   return v is map && 'kind' in v && (
    (v.kind == 'answer' && v.keys().hasAll(['kind','mapId','targetId','roundId','grade','date'])
     && v.keys().hasOnly(['kind','mapId','targetId','roundId','grade','date','chosenId'])
     && text(v.mapId, 128) && text(v.targetId, 256) && token(v.roundId)
     && v.grade in ['good','hard','again'] && day(v.date)
     && (!('chosenId' in v) || text(v.chosenId, 256)))
    || (v.kind == 'round' && v.keys().hasAll(['kind','mapId','roundId','summary','slipped'])
     && v.keys().hasOnly(['kind','mapId','roundId','summary','slipped','timedMs'])
     && text(v.mapId, 128) && token(v.roundId) && summary(v.summary)
     && integer(v.slipped, 0, v.summary.total)
     && (!('timedMs' in v) || number(v.timedMs, 0.001, 1000000000000)))
    || (v.kind == 'import-card' && v.keys().hasAll(['kind','mapId','targetId','state'])
     && v.keys().hasOnly(['kind','mapId','targetId','state'])
     && text(v.mapId, 128) && text(v.targetId, 256) && state(v.state))
    || (v.kind == 'import-map' && v.keys().hasAll(['kind','mapId','records'])
     && v.keys().hasOnly(['kind','mapId','summary','records'])
     && text(v.mapId, 128) && records(v.records) && (!('summary' in v) || summary(v.summary)))
    || (v.kind == 'reset' && 'scope' in v && (
     (v.scope == 'all' && v.keys().hasAll(['kind','scope']) && v.keys().hasOnly(['kind','scope']))
     || (v.scope in ['known','map'] && v.keys().hasAll(['kind','scope','mapId'])
      && v.keys().hasOnly(['kind','scope','mapId']) && text(v.mapId, 128))
    ))
   );
  }
  function owner(uid) {
   return request.auth != null && request.auth.uid == uid
    && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function envelope(v, uid, id) {
   return v.keys().hasAll(['version','id','projectId','uid','deviceId','sequence','logicalTime','parents','operationKey','operation'])
    && v.keys().hasOnly(['version','id','projectId','uid','deviceId','sequence','logicalTime','parents','operationKey','operation'])
    && v.version == 1 && v.id == id && token(v.id) && v.uid == uid
    && v.projectId == request.auth.token.aud && text(v.projectId, 128) && text(v.uid, 128)
    && token(v.deviceId) && integer(v.sequence, 1, 9007199254740991)
    && integer(v.logicalTime, 1, 9007199254740991) && text(v.operationKey, 512)
    && v.parents is string && v.parents.size() <= 16511
    && v.parents.matches('([A-Za-z0-9_-]{1,128}(,[A-Za-z0-9_-]{1,128}){0,127})?')
    && operation(v.operation);
  }
  function headPath(uid) { return /databases/$(database)/documents/users/$(uid)/progressSyncV2/head; }
  function deliveryPath(uid, id) { return /databases/$(database)/documents/users/$(uid)/progressEventsV2/$(id); }
  function headFields(v) {
   return v.keys().hasAll(['version','sequence','lastEventId'])
    && v.keys().hasOnly(['version','sequence','lastEventId']) && v.version == 2
    && integer(v.sequence, 0, 9007199254740991)
    && (v.sequence == 0 ? v.lastEventId == null : token(v.lastEventId));
  }
  match /users/{uid}/progressSyncV2/head {
   allow get: if owner(uid);
   allow create: if owner(uid) && headFields(request.resource.data)
    && request.resource.data.sequence == 0 && request.resource.data.lastEventId == null;
   allow update: if owner(uid) && headFields(request.resource.data)
    && request.resource.data.sequence == resource.data.sequence + 1
    && !exists(deliveryPath(uid, request.resource.data.lastEventId))
    && getAfter(deliveryPath(uid, request.resource.data.lastEventId)).data.sequence == request.resource.data.sequence;
  }
  match /users/{uid}/progressEventsV2/{id} {
   allow get: if owner(uid);
   allow list: if owner(uid) && request.query.limit != null && request.query.limit <= 100;
   allow create: if owner(uid)
    && request.resource.data.keys().hasAll(['sequence','event'])
    && request.resource.data.keys().hasOnly(['sequence','event'])
    && integer(request.resource.data.sequence, 1, 9007199254740991)
    && envelope(request.resource.data.event, uid, id)
    && exists(headPath(uid))
    && getAfter(headPath(uid)).data.sequence == get(headPath(uid)).data.sequence + 1
    && getAfter(headPath(uid)).data.sequence == request.resource.data.sequence
    && getAfter(headPath(uid)).data.lastEventId == id;
   allow update: if owner(uid) && request.resource.data == resource.data;
  }
  match /users/{uid}/progressEventsV1/{id} {
   allow get: if owner(uid);
   allow list: if owner(uid)
    && request.query.limit != null && request.query.limit <= 100;
   allow create: if owner(uid) && !exists(headPath(uid)) && envelope(request.resource.data, uid, id);
   allow update: if owner(uid)
    && request.resource.data == resource.data;
   // Deletion would destroy causal/reset history. Everything else is denied.
  }
 }
}
