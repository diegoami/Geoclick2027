{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Geoclick",
  "version": "0.9.3",
  "identifier": "com.geoclick.desktop",
  "build": {
    "frontendDist": "../../app/build",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace=app --prefix .."
  },
  "app": {
    "windows": [
      {
        "title": "Geoclick",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
