{
  "name": "geoclick-firebase-android-proof",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../../node_modules/vite/bin/vite.js --config vite.config.mjs --host 127.0.0.1 --port 5198 --strictPort",
    "build": "node ../../../node_modules/vite/bin/vite.js build --config vite.config.mjs",
    "add:android": "cap add android",
    "sync": "cap sync android",
    "configure": "node scripts/configure.mjs",
    "build:android": "node scripts/build-android.mjs",
    "test:ui": "node browser.test.mjs",
    "test": "node --test --test-reporter=dot scripts/configure.test.mjs scripts/device-safety.test.mjs && node browser.test.mjs",
    "install:emulator": "node scripts/install-emulator.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor-firebase/authentication": "8.6.0",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
