{
	// Typechecks the map-build scripts (GC-004). They run under tsx as native
	// ESM (root package.json "type": "module"), so NodeNext resolution matches
	// how they're actually executed - including the './x.js' import specifiers.
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["scripts/**/*.ts"]
}
